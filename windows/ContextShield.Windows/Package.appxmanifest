<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10" xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" IgnorableNamespaces="uap">
  <Identity Name="ContextShield.Demo" Publisher="CN=ContextShieldDemo" Version="0.1.0.0" />
  <Properties><DisplayName>Контекст антифрод</DisplayName><PublisherDisplayName>ContextShield Demo</PublisherDisplayName><Logo>Assets\StoreLogo.png</Logo></Properties>
  <Dependencies><TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" /></Dependencies>
  <Resources><Resource Language="ru-RU" /></Resources>
  <Applications><Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="ContextShield.Windows.App" ToastCapable="true">
    <uap:VisualElements DisplayName="Контекст антифрод" Description="Локальная оценка риска уведомлений" BackgroundColor="#101917" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"><uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" /></uap:VisualElements>
  </Application></Applications>
  <Capabilities><uap:Capability Name="userNotificationListener" /></Capabilities>
</Package>
